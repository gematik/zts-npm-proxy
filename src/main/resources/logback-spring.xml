<configuration>

    <!-- Console appender for logging to the console (STDOUT) -->
    <appender name="console" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>time</fieldName>
                </timestamp>
                <provider class="de.gematik.zts.npmproxy.logging.CustomLogLevelJsonProvider"/>
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>
                <message>
                    <fieldName>message</fieldName>
                </message>
                <stackTrace>
                    <fieldName>exception</fieldName>
                </stackTrace>
                <logstashMarkers/>
            </providers>
        </encoder>
        <filter class="ch.qos.logback.core.filter.EvaluatorFilter">
            <evaluator class="de.gematik.zts.npmproxy.logging.LogLevelThresholdEvaluator">
                <!-- logs everything with level < ERROR -->
                <threshold>ERROR</threshold>
            </evaluator>
            <OnMismatch>DENY</OnMismatch>
            <OnMatch>ACCEPT</OnMatch>
        </filter>
    </appender>

    <!-- Console appender for logging to the console (STDERR) -->
    <appender name="console-error" class="ch.qos.logback.core.ConsoleAppender">
        <!-- target stderr -->
        <target>System.err</target>
        <!-- Configure JSON Logging -->
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>

                <timestamp>
                    <fieldName>time</fieldName>
                </timestamp>
                <provider class="de.gematik.zts.npmproxy.logging.CustomLogLevelJsonProvider"/>
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>
                <message>
                    <fieldName>message</fieldName>
                </message>
                <stackTrace>
                    <fieldName>exception</fieldName>
                </stackTrace>
                <logstashMarkers/>
            </providers>
        </encoder>
        <!-- logs everything with level = ERROR -->
        <filter class="ch.qos.logback.classic.filter.LevelFilter">
            <level>ERROR</level>
            <OnMismatch>DENY</OnMismatch>
            <OnMatch>ACCEPT</OnMatch>
        </filter>
    </appender>

    <root level="info">
        <appender-ref ref="console"/>
        <appender-ref ref="console-error"/>
    </root>
</configuration>